{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"enableAllProjectMcpServers": true,
	"permissions": {
		"allow": [
			"Bash(pnpm install)",
			"Bash(pnpm dev:*)",
			"Bash(pnpm build:*)",
			"Bash(pnpm test:*)",
			"Bash(pnpm lint:*)",
			"Bash(pnpm format:*)",
			"Bash(pnpm email:dev:*)",
			"Bash(npx convex:*)",
			"Bash(pnpm exec playwright:*)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/droast-dockerfile.sh\"",
						"timeout": 30,
						"statusMessage": "Roasting Dockerfile..."
					}
				]
			}
		]
	}
}
